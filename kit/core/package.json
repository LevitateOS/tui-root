{
	"name": "@levitate/tui-kit",
	"version": "0.3.0",
	"private": true,
	"description": "Reusable terminal UI primitives for LevitateOS",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"ink": "^6.8.0",
		"react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"peerDependencies": {
		"ink": "^6.8.0",
		"react": "^19.2.0"
	}
}
