{
	"name": "@levitate/install-state",
	"version": "0.1.0",
	"private": true,
	"description": "The install steps' shared state file, read and written by the install apps",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"typescript": "^5.9.2"
	}
}
