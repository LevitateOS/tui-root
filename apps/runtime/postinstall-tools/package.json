{
  "name": "@levitate/tui-runtime-postinstall-tools",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "levitate-runtime-postinstall-tools": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "bunx oxlint src --deny-warnings",
    "lint:fix": "bunx oxlint src --fix",
    "format": "bunx oxfmt --write src package.json tsconfig.json",
    "format:check": "bunx oxfmt --check src package.json tsconfig.json",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@levitate/tui-kit": "file:../../../kit/core",
    "ink": "^6.8.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2"
  }
}
