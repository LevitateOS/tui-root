#!/bin/sh
# Stand-in for recab in headless runs (cargo xtask inspect, check tui, stories): it never
# touches firmware, boot entries or disks. It starts as a machine running committed slot A
# whose last trial of B failed; RECAB_FIXTURE selects another start:
#   trial        slot B is set for a one-shot trial boot
#   uncommitted  running slot B on trial, not committed yet
#   fresh        just installed: no trial yet, nothing to roll back to
#   no-status    status fails as on a system recab doesn't manage
#   fail         every change fails for want of root
# Changes follow recab's rules (tools/recab/src/state.rs) and persist for the app that
# ran them (one state file per parent process), so the app sees their effect.
# Keep the JSON in the shape of recab's `Status` (src/generated/recab.ts).
mode=${RECAB_FIXTURE:-}
dir=${TMPDIR:-/tmp}
file=$dir/recab-fixture-$PPID
# State files of apps that have exited go.
for old in "$dir"/recab-fixture-*; do
	[ -e "$old" ] && ! kill -0 "${old##*-}" 2>/dev/null && rm -f "$old"
done
if [ -f "$file" ]; then
	. "$file"
else
	active=A inactive=B oneshot=null default=A known=A previous=B last=failed
	case "$mode" in
	trial) oneshot=B ;;
	uncommitted) active=B inactive=A previous=null last=none ;;
	fresh) previous=null last=none ;;
	esac
fi
save() {
	echo "active=$active inactive=$inactive oneshot=$oneshot default=$default known=$known previous=$previous last=$last" >"$file"
}
q() { if [ "$1" = null ]; then echo null; else echo "\"$1\""; fi; }
refuse() {
	echo "recab: [RECAB_ERR_STATE] $1" >&2
	exit 21
}
[ "$known" = "$active" ] && committed=true || committed=false
if [ "$oneshot" != null ]; then next=$oneshot; else next=$default; fi
if [ "$committed" = false ] || [ "$oneshot" != null ]; then rollback=$known; else rollback=$previous; fi
case "$1" in
status) ;;
set-next | commit | rollback | stage)
	if [ "$mode" = fail ]; then
		echo "recab: [RECAB_ERR_PERMISSION] cannot write EFI variable LoaderEntryOneShot: Permission denied" >&2
		exit 13
	fi
	;;
*)
	echo "fixture recab: unsupported: $*" >&2
	exit 2
	;;
esac
case "$1" in
status)
	if [ "$mode" = no-status ]; then
		echo "recab: [RECAB_ERR_STATE] no A/B layout found (no slot entries under /boot/loader/entries)" >&2
		exit 21
	fi
	[ "$oneshot" != null ] && pending=true || pending=false
	if [ "$last" = none ]; then
		trial=null
	else
		trial='{
    "slot": "B",
    "committed": false,
    "detail": "degraded: sshd.service failed",
    "unix_time": 1793900000
  }'
	fi
	cat <<JSON
{
  "active_slot": "$active",
  "inactive_slot": "$inactive",
  "trial_pending": $pending,
  "next_boot": $(q "$next"),
  "default_slot": $(q "$default"),
  "known_good_slot": $(q "$known"),
  "committed": $committed,
  "rollback_slot": $(q "$rollback"),
  "last_trial": $trial,
  "entry_prefix": "levitate"
}
JSON
	;;
set-next)
	slot=$(echo "$2" | tr ab AB)
	[ "$slot" = "$active" ] && refuse "slot $slot is the running slot; set-next stages the inactive slot ($inactive)."
	[ "$oneshot" = "$slot" ] && exit 0
	[ "$default" = "$known" ] || refuse "cannot stage trial boot: default slot ($default) is not the known-good slot ($known)"
	oneshot=$slot
	save
	;;
commit)
	[ "$committed" = true ] && [ "$default" = "$active" ] && [ "$oneshot" = null ] && exit 0
	[ "$known" != "$active" ] && previous=$known
	known=$active default=$active oneshot=null
	save
	;;
rollback)
	[ "$rollback" = null ] && refuse "cannot rollback: slot $active is committed and no other slot has been known-good since it was written"
	[ "$rollback" != "$active" ] && [ "$committed" = true ] && previous=$active
	known=$rollback default=$rollback oneshot=null
	save
	;;
stage)
	[ "$committed" = true ] || refuse "slot $active is running uncommitted, so slot $inactive is the fallback"
	[ "$next" = "$inactive" ] && refuse "the next boot is slot $inactive"
	sleep 0.2
	[ "$previous" = "$inactive" ] && previous=null
	save
	;;
esac
