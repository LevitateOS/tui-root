{
	"name": "@levitate/recab-tui",
	"version": "0.1.0",
	"private": true,
	"bin": {
		"recab-tui": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recab"
		],
		"inspect": {
			"path": [
				"fixtures"
			],
			"stories": [
				{
					"name": "status",
					"steps": [
						{
							"expect": "active        : A"
						}
					]
				},
				{
					"name": "trial pending",
					"env": {
						"RECAB_FIXTURE": "trial"
					},
					"steps": [
						{
							"expect": "trial_pending : yes"
						}
					]
				},
				{
					"name": "status unreadable",
					"env": {
						"RECAB_FIXTURE": "no-status"
					},
					"steps": [
						{
							"expect": "no A/B layout found"
						}
					]
				},
				{
					"name": "set next boot",
					"steps": [
						{
							"keys": "b",
							"expect": "recab set-next B (exit 0"
						}
					]
				},
				{
					"name": "change fails",
					"env": {
						"RECAB_FIXTURE": "fail"
					},
					"steps": [
						{
							"keys": "c",
							"expect": "Permission denied"
						}
					]
				}
			]
		}
	}
}
