{
	"name": "@levitate/recab-tui",
	"version": "0.1.0",
	"private": true,
	"description": "A/B slots at a glance, and recab's changes (try, commit, roll back, write a system) with their effect before and after",
	"bin": {
		"recab-tui": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recab"
		],
		"inspect": {
			"path": [
				"fixtures"
			],
			"stories": [
				{
					"name": "overview",
					"steps": [
						{
							"expect": "Running slot A, committed"
						}
					]
				},
				{
					"name": "trial pending",
					"env": {
						"RECAB_FIXTURE": "trial"
					},
					"steps": [
						{
							"expect": "Slot B boots once on the next reboot"
						}
					]
				},
				{
					"name": "running a trial",
					"env": {
						"RECAB_FIXTURE": "uncommitted"
					},
					"steps": [
						{
							"expect": "Running slot B on trial: not committed"
						}
					]
				},
				{
					"name": "status unreadable",
					"env": {
						"RECAB_FIXTURE": "no-status"
					},
					"steps": [
						{
							"expect": "recab couldn't read the A/B state"
						}
					]
				},
				{
					"name": "try the other slot",
					"steps": [
						{
							"keys": "t",
							"expect": "Try slot B on the next boot"
						},
						{
							"keys": "\\r",
							"expect": "Run recab set-next B?"
						},
						{
							"keys": "y",
							"expect": "Reboot to start the trial"
						}
					]
				},
				{
					"name": "commit a trial",
					"env": {
						"RECAB_FIXTURE": "uncommitted"
					},
					"steps": [
						{
							"keys": "c\\ry",
							"expect": "Slot B is committed"
						}
					]
				},
				{
					"name": "nothing to roll back to",
					"env": {
						"RECAB_FIXTURE": "fresh"
					},
					"steps": [
						{
							"keys": "x",
							"expect": "recab would refuse this now"
						}
					]
				},
				{
					"name": "write a system",
					"steps": [
						{
							"keys": "s\\r",
							"expect": "The system image"
						},
						{
							"keys": "/nonexistent\\r",
							"expect": "doesn't exist"
						},
						{
							"keys": "\\x1b"
						},
						{
							"keys": "\\r/etc/os-release\\r/etc/os-release\\r\\r",
							"expect": "Type B to erase slot B"
						},
						{
							"keys": "B\\r",
							"expect": "Slot B holds the new system"
						}
					]
				},
				{
					"name": "change fails",
					"env": {
						"RECAB_FIXTURE": "fail"
					},
					"steps": [
						{
							"keys": "t\\ry",
							"expect": "Run recab-tui as root"
						}
					]
				}
			]
		}
	}
}
