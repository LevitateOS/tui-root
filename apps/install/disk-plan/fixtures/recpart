#!/bin/sh
# Stand-in for recpart in headless runs (cargo xtask inspect, check tui): it answers
# from documents recorded from the real recpart (./record.sh) for fixture disks and
# never touches a device. The disks: /dev/vdz empty 64G (the only one listed unless
# RECPART_FIXTURE_DISKS=all), /dev/vdy Windows with its EFI partition, /dev/vdx one
# nearly full ext4 partition, /dev/vdw a partition off 4 KiB alignment, /dev/vdv a running
# system on XFS whose partitions can't shrink.
# A template plan answers plan-<mode>.json on vdz, plan-<mode>-<disk>.json elsewhere;
# --layout FILE answers by FILE's name (layouts/<name>.json), or by the recorded layout
# with the same content (the editor names its files by hash): plan-<name>.json, or
# error-<name>.json on stderr with its code as the exit status when recpart refuses it.
# With RECPART_FIXTURE_LIVE set to a recpart binary (or LEVITATE_REAL_TOOLS to the directory
# holding one, as `cargo xtask tui disk-plan --stand-ins` sets it), a layout nothing recorded
# matches is planned (and dry-run) by that recpart against the fixture disk's recorded
# inventory, for trying the editor by hand; it never applies.
# RECPART_FIXTURE_APPLY=fail makes the real apply fail;
# RECPART_FIXTURE_DRY_RUN=refuse makes the dry run report a disk apply would refuse.
# Re-record with ./record.sh when recpart's output changes (the TUI reports a schema mismatch).
dir=$(dirname "$0")
mode=ab
disk=vdz
layout=
dry=0
prev=
for arg in "$@"; do
	case "$prev" in
	--mode) mode=$arg ;;
	--disk) disk=${arg##*/} ;;
	--layout)
		layout=$(basename "$arg" .json)
		layout_file=$arg
		;;
	esac
	[ "$arg" = --dry-run ] && dry=1
	prev=$arg
done
if [ -n "$layout" ]; then
	key=$layout
	if [ ! -f "$dir/layouts/$layout.json" ]; then
		wanted=$(jq -S -c . "$layout_file")
		for recorded in "$dir"/layouts/*.json; do
			if [ "$(jq -S -c . "$recorded")" = "$wanted" ]; then
				key=$(basename "$recorded" .json)
				break
			fi
		done
		live=${RECPART_FIXTURE_LIVE:-${LEVITATE_REAL_TOOLS:+$LEVITATE_REAL_TOOLS/recpart}}
		if [ "$key" = "$layout" ] && [ -n "$live" ] && [ "$1" != apply -o "$dry" = 1 ]; then
			exec "$live" "$@" --inventory "$dir/inspect-$disk.json"
		fi
	fi
elif [ "$disk" = vdz ]; then
	key=$mode
else
	key=$mode-$disk
fi

# answer <kind>: the recorded <kind>-<key>.json, or the recorded refusal.
answer() {
	if [ -f "$dir/error-$key.json" ]; then
		cat "$dir/error-$key.json" >&2
		exit "$(sed -n 's/.*"code": "E0*\([0-9]*\)".*/\1/p' "$dir/error-$key.json")"
	fi
	if [ ! -f "$dir/$1-$key.json" ]; then
		echo "fixture recpart: nothing recorded for $1 $key" >&2
		exit 2
	fi
	cat "$dir/$1-$key.json"
}

case "$1" in
list-disks)
	if [ "${RECPART_FIXTURE_DISKS:-}" = all ]; then
		cat "$dir/list-disks-all.json"
	else
		cat "$dir/list-disks.json"
	fi
	;;
inspect) cat "$dir/inspect-$disk.json" ;;
plan) answer plan ;;
apply)
	if [ "$dry" = 1 ] && [ "${RECPART_FIXTURE_DRY_RUN:-}" = refuse ]; then
		cat "$dir/dry-run-refused.json"
	elif [ "$dry" = 1 ]; then
		answer dry-run
	elif [ "${RECPART_FIXTURE_APPLY:-}" = fail ]; then
		cat "$dir/apply-fail.json" >&2
		exit 1
	else
		answer apply
	fi
	;;
*)
	echo "fixture recpart: unsupported: $*" >&2
	exit 2
	;;
esac
