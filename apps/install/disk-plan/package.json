{
	"name": "@levitate/disk-plan",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"disk-plan": "./src/main.ts"
	},
	"levitate": {
		"tools": [
			"recpart"
		],
		"inspect": {
			"refuse": [
				"recpart apply --confirm"
			]
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	}
}
