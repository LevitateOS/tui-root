{
	"name": "@levitate/disk-plan",
	"version": "0.1.0",
	"private": true,
	"description": "plan, check and apply a disk layout with the recpart on PATH",
	"bin": {
		"disk-plan": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*",
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recpart"
		],
		"inspect": {
			"path": [
				"fixtures"
			],
			"stories": [
				{
					"name": "apply succeeds",
					"steps": [
						{
							"keys": "",
							"expect": "│Overview"
						},
						{
							"keys": "j",
							"expect": "│Step 1 of 8 · Disk"
						},
						{
							"keys": "j",
							"expect": "│Step 2 of 8 · Layout"
						},
						{
							"keys": "j",
							"expect": "│Step 3 of 8 · Plan"
						},
						{
							"keys": "",
							"expect": "sfdisk script"
						},
						{
							"keys": "j",
							"expect": "│Step 4 of 8 · Commands"
						},
						{
							"keys": "",
							"expect": "What apply will run"
						},
						{
							"keys": "j",
							"expect": "✓ recpart would apply to this disk"
						},
						{
							"keys": "j",
							"expect": "│Step 6 of 8 · Confirm"
						},
						{
							"keys": "q",
							"expect": "› q______"
						},
						{
							"keys": "\\x7f",
							"expect": "› _______"
						},
						{
							"keys": "DESTROY",
							"expect": "Unlocked. Enter starts the apply."
						},
						{
							"keys": "\\r",
							"expect": "Apply completed"
						},
						{
							"keys": "j",
							"expect": "│Step 8 of 8 · Done"
						},
						{
							"keys": "j",
							"expect": "│Step 8 of 8 · Done"
						},
						{
							"keys": "",
							"expect": "recstrap /mnt"
						}
					]
				},
				{
					"name": "apply fails",
					"env": {
						"RECPART_FIXTURE_APPLY": "fail"
					},
					"steps": [
						{
							"keys": "",
							"expect": "│Overview"
						},
						{
							"keys": "j",
							"expect": "│Step 1 of 8 · Disk"
						},
						{
							"keys": "j",
							"expect": "│Step 2 of 8 · Layout"
						},
						{
							"keys": "j",
							"expect": "│Step 3 of 8 · Plan"
						},
						{
							"keys": "",
							"expect": "sfdisk script"
						},
						{
							"keys": "j",
							"expect": "│Step 4 of 8 · Commands"
						},
						{
							"keys": "",
							"expect": "What apply will run"
						},
						{
							"keys": "j",
							"expect": "✓ recpart would apply to this disk"
						},
						{
							"keys": "j",
							"expect": "│Step 6 of 8 · Confirm"
						},
						{
							"keys": "q",
							"expect": "› q______"
						},
						{
							"keys": "\\x7f",
							"expect": "› _______"
						},
						{
							"keys": "DESTROY",
							"expect": "Unlocked. Enter starts the apply."
						},
						{
							"keys": "\\r",
							"expect": "Apply failed"
						},
						{
							"keys": "j",
							"expect": "│Failure"
						},
						{
							"keys": "",
							"expect": "Failure in apply"
						},
						{
							"keys": "k",
							"expect": "│Step 7 of 8 · Apply"
						}
					]
				},
				{
					"name": "disk refused",
					"env": {
						"RECPART_FIXTURE_DRY_RUN": "refuse"
					},
					"steps": [
						{
							"keys": "jjjjj",
							"expect": "recpart would refuse this disk"
						},
						{
							"keys": " ",
							"expect": "Disk Preparation › 2. Identify Target Disk"
						}
					]
				},
				{
					"name": "edit: incomplete layout",
					"args": [
						"--disk",
						"/dev/vdz"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jj\\r\\x1b[B\\r",
							"expect": "Not a valid ab layout yet"
						},
						{
							"keys": "",
							"expect": "Give one partition role efi."
						}
					]
				},
				{
					"name": "edit: dual boot",
					"args": [
						"--disk",
						"/dev/vdy"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jj\\r\\x1b[B\\r",
							"expect": "│Step 3 of 9 · Partitions"
						},
						{
							"keys": "m",
							"expect": "What /dev/vdy1 is for"
						},
						{
							"keys": "\\rjjr",
							"expect": "Resize /dev/vdy3"
						},
						{
							"keys": "150G",
							"expect": "= 150.0 GB"
						},
						{
							"keys": "\\rjn30G\\rj\\rjn30G\\rjj\\rjn\\rjjj\\r",
							"expect": "recpart accepts this ab layout"
						},
						{
							"keys": "",
							"expect": "shrink"
						},
						{
							"keys": "\\rjjj",
							"expect": "Nothing on /dev/vdy is erased: this resizes 1 partition and creates 3"
						}
					]
				}
			]
		}
	}
}
