{
	"name": "@levitate/disk-plan",
	"version": "0.1.0",
	"private": true,
	"description": "plan, check and apply a disk layout with the recpart on PATH",
	"bin": {
		"disk-plan": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*",
		"@levitate/install-state": "workspace:*",
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recpart"
		],
		"inspect": {
			"path": [
				"fixtures"
			],
			"stories": [
				{
					"name": "apply succeeds",
					"about": "The whole erase-the-disk flow on the empty 64 GB disk: every page, typing DESTROY, the apply, the result saved to the install state file, and the hand-off to recstrap.",
					"steps": [
						{
							"keys": "",
							"expect": "│Overview"
						},
						{
							"keys": "j",
							"expect": "│Step 1 of 9 · Disk"
						},
						{
							"keys": "j",
							"expect": "│Step 2 of 9 · System"
						},
						{
							"keys": "j",
							"expect": "│Step 3 of 9 · Disk use"
						},
						{
							"keys": "j",
							"expect": "│Step 4 of 9 · Plan"
						},
						{
							"keys": "",
							"expect": "sfdisk script"
						},
						{
							"keys": "j",
							"expect": "│Step 5 of 9 · Commands"
						},
						{
							"keys": "",
							"expect": "What apply will run"
						},
						{
							"keys": "j",
							"expect": "✓ recpart would apply to this disk"
						},
						{
							"keys": "j",
							"expect": "│Step 7 of 9 · Confirm"
						},
						{
							"keys": "q",
							"expect": "› q______"
						},
						{
							"keys": "\\x7f",
							"expect": "› _______"
						},
						{
							"keys": "DESTROY",
							"expect": "Unlocked. Enter starts the apply."
						},
						{
							"keys": "\\r",
							"expect": "Apply completed"
						},
						{
							"keys": "j",
							"expect": "│Step 9 of 9 · Done"
						},
						{
							"keys": "j",
							"expect": "│Step 9 of 9 · Done"
						},
						{
							"keys": "",
							"expect": "recstrap /mnt"
						},
						{
							"keys": "",
							"expect": "Saved for the next install steps in /tmp/install-disk-plan-story/state.json."
						}
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-disk-plan-story/state.json"
					}
				},
				{
					"name": "apply fails",
					"about": "The same flow where the apply fails part way: the failure page and the step it failed at.",
					"env": {
						"RECPART_FIXTURE_APPLY": "fail"
					},
					"steps": [
						{
							"keys": "",
							"expect": "│Overview"
						},
						{
							"keys": "j",
							"expect": "│Step 1 of 9 · Disk"
						},
						{
							"keys": "j",
							"expect": "│Step 2 of 9 · System"
						},
						{
							"keys": "j",
							"expect": "│Step 3 of 9 · Disk use"
						},
						{
							"keys": "j",
							"expect": "│Step 4 of 9 · Plan"
						},
						{
							"keys": "",
							"expect": "sfdisk script"
						},
						{
							"keys": "j",
							"expect": "│Step 5 of 9 · Commands"
						},
						{
							"keys": "",
							"expect": "What apply will run"
						},
						{
							"keys": "j",
							"expect": "✓ recpart would apply to this disk"
						},
						{
							"keys": "j",
							"expect": "│Step 7 of 9 · Confirm"
						},
						{
							"keys": "q",
							"expect": "› q______"
						},
						{
							"keys": "\\x7f",
							"expect": "› _______"
						},
						{
							"keys": "DESTROY",
							"expect": "Unlocked. Enter starts the apply."
						},
						{
							"keys": "\\r",
							"expect": "Apply failed"
						},
						{
							"keys": "j",
							"expect": "│Failure"
						},
						{
							"keys": "",
							"expect": "Failure in apply"
						},
						{
							"keys": "k",
							"expect": "│Step 8 of 9 · Apply"
						}
					]
				},
				{
					"name": "apply refused: the disk changed",
					"about": "recpart refuses the apply because the disk no longer gives the confirmed plan (E023, nothing written); R reads the disks again and starts over at the disk.",
					"env": {
						"RECPART_FIXTURE_APPLY": "changed"
					},
					"steps": [
						{
							"keys": "jjjjjjj",
							"expect": "│Step 7 of 9 · Confirm"
						},
						{
							"keys": "DESTROY\\r",
							"expect": "Apply failed"
						},
						{
							"keys": "j",
							"expect": "Nothing was written: the disk changed since you reviewed it"
						},
						{
							"keys": "R",
							"expect": "│Step 1 of 9 · Disk"
						},
						{
							"keys": "jjjjjj",
							"expect": "│Step 7 of 9 · Confirm"
						},
						{
							"keys": "",
							"expect": "› _______"
						}
					]
				},
				{
					"name": "disk refused",
					"about": "The dry run reports a disk apply would refuse (a partition mounted), so Checks blocks the way to Confirm.",
					"env": {
						"RECPART_FIXTURE_DRY_RUN": "refuse"
					},
					"steps": [
						{
							"keys": "jjjjjj",
							"expect": "recpart would refuse this disk"
						},
						{
							"keys": " ",
							"expect": "Disk Preparation › 2. Identify Target Disk"
						}
					]
				},
				{
					"name": "edit: empty disk with quick setup",
					"about": "Keep some of an empty disk: the Next step box offers a, which creates EFI, both slots and state.",
					"args": [
						"--disk",
						"/dev/vdz"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jjj\\r\\x1b[B\\r",
							"expect": "Next: press a to set up A/B in the 64.0 GiB free"
						},
						{
							"keys": "",
							"expect": "new EFI partition: 1.0 GiB"
						},
						{
							"keys": "a",
							"expect": "Ready: recpart accepts this layout"
						}
					]
				},
				{
					"name": "edit: dual boot with quick setup",
					"about": "Windows disk: s opens the make-room slider on Windows, Enter shrinks it, a fills the space; nothing is erased.",
					"args": [
						"--disk",
						"/dev/vdy"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jjj\\r\\x1b[B\\r",
							"expect": "Next: press s to make room for A/B"
						},
						{
							"keys": "s",
							"expect": "Make room: shrink vdy3 (\"Windows\")"
						},
						{
							"keys": "",
							"expect": "for the new system: 83.3 GiB"
						},
						{
							"keys": "\\r",
							"expect": "Next: press a to set up A/B in the 83.3 GiB free"
						},
						{
							"keys": "a",
							"expect": "Ready: recpart accepts this layout"
						},
						{
							"keys": "",
							"expect": "System slot A  new"
						},
						{
							"keys": "\\rjjj",
							"expect": "Nothing on /dev/vdy is erased: this resizes 1 partition and creates 3"
						}
					]
				},
				{
					"name": "edit: dual boot by hand",
					"about": "Windows disk, partition by partition: reuse the EFI partition, shrink Windows to 150 GB, create both slots and state.",
					"args": [
						"--disk",
						"/dev/vdy"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jjj\\r\\x1b[B\\r",
							"expect": "│Step 4 of 10 · Partitions"
						},
						{
							"keys": "m",
							"expect": "What is /dev/vdy1 for?"
						},
						{
							"keys": "\\rjjr",
							"expect": "Make room: shrink vdy3"
						},
						{
							"keys": "107264M",
							"expect": "Windows: 150.0 GiB"
						},
						{
							"keys": "\\rn30G\\rj\\rjn30G\\rjj\\rjn\\rjjj\\r",
							"expect": "Ready: recpart accepts this layout"
						},
						{
							"keys": "",
							"expect": "shrunk"
						},
						{
							"keys": "\\rjjj",
							"expect": "Nothing on /dev/vdy is erased: this resizes 1 partition and creates 3"
						}
					]
				},
				{
					"name": "edit: nothing can shrink",
					"about": "A running XFS system (like a Fedora install): nothing can shrink, and the page says why and what is left to do.",
					"args": [
						"--disk",
						"/dev/vdv"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jjj\\r\\x1b[B\\r",
							"expect": "No partition here can be made smaller"
						},
						{
							"keys": "",
							"expect": "vdv4 (xfs, 467.4 GiB, 66.5 GiB used): XFS can only grow, never shrink"
						},
						{
							"keys": "",
							"expect": "This disk holds the system running now"
						}
					]
				},
				{
					"name": "disk use: what erasing loses",
					"about": "The Disk use page on the Windows disk: what erasing would lose, in red, then choosing to keep some of it.",
					"args": [
						"--disk",
						"/dev/vdy"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jj",
							"expect": "How is the system updated?"
						},
						{
							"keys": "j",
							"expect": "Erases all 4 partitions below."
						},
						{
							"keys": "\\r\\x1b[B",
							"expect": "Disk use  keep some"
						}
					]
				},
				{
					"name": "disk use: an encrypted disk",
					"about": "A disk that is one LUKS container with no partition table: Disk use and Confirm say the container is erased.",
					"args": [
						"--disk",
						"/dev/vdu"
					],
					"env": {
						"RECPART_FIXTURE_DISKS": "all"
					},
					"steps": [
						{
							"keys": "jjj",
							"expect": "Erases an encrypted LUKS container"
						},
						{
							"keys": "",
							"expect": "No partition table, but the whole disk holds:"
						},
						{
							"keys": "jjjj",
							"expect": "Also erased"
						}
					]
				}
			]
		}
	}
}
