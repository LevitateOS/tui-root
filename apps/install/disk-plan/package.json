{
	"name": "@levitate/disk-plan",
	"version": "0.1.0",
	"private": true,
	"bin": {
		"disk-plan": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recpart"
		],
		"inspect": {
			"path": [
				"fixtures"
			],
			"walks": [
				{
					"name": "apply succeeds",
					"steps": [
						{
							"keys": "",
							"expect": "│welcome"
						},
						{
							"keys": "j",
							"expect": "│target-disk"
						},
						{
							"keys": "j",
							"expect": "│mode-selection"
						},
						{
							"keys": "j",
							"expect": "│plan-preview"
						},
						{
							"keys": "",
							"expect": "sfdisk script"
						},
						{
							"keys": "j",
							"expect": "│command-preview"
						},
						{
							"keys": "",
							"expect": "What apply would do"
						},
						{
							"keys": "j",
							"expect": "[OK] recpart would apply"
						},
						{
							"keys": "j",
							"expect": "│destructive-confirm"
						},
						{
							"keys": "q",
							"expect": "Type DESTROY to unlock: q"
						},
						{
							"keys": "\\x7f",
							"expect": "Type DESTROY to unlock: (empty)"
						},
						{
							"keys": "DESTROY",
							"expect": "Unlocked: Enter starts the apply."
						},
						{
							"keys": "\\r",
							"expect": "Apply completed"
						},
						{
							"keys": "j",
							"expect": "│result-handoff"
						},
						{
							"keys": "j",
							"expect": "│result-handoff"
						},
						{
							"keys": "",
							"expect": "recstrap /mnt"
						}
					]
				},
				{
					"name": "apply fails",
					"env": {
						"RECPART_FIXTURE_APPLY": "fail"
					},
					"steps": [
						{
							"keys": "",
							"expect": "│welcome"
						},
						{
							"keys": "j",
							"expect": "│target-disk"
						},
						{
							"keys": "j",
							"expect": "│mode-selection"
						},
						{
							"keys": "j",
							"expect": "│plan-preview"
						},
						{
							"keys": "",
							"expect": "sfdisk script"
						},
						{
							"keys": "j",
							"expect": "│command-preview"
						},
						{
							"keys": "",
							"expect": "What apply would do"
						},
						{
							"keys": "j",
							"expect": "[OK] recpart would apply"
						},
						{
							"keys": "j",
							"expect": "│destructive-confirm"
						},
						{
							"keys": "q",
							"expect": "Type DESTROY to unlock: q"
						},
						{
							"keys": "\\x7f",
							"expect": "Type DESTROY to unlock: (empty)"
						},
						{
							"keys": "DESTROY",
							"expect": "Unlocked: Enter starts the apply."
						},
						{
							"keys": "\\r",
							"expect": "Apply failed"
						},
						{
							"keys": "j",
							"expect": "│failure-diagnostics"
						},
						{
							"keys": "",
							"expect": "Failure in apply"
						},
						{
							"keys": "k",
							"expect": "│apply-progress"
						}
					]
				}
			]
		}
	}
}
