{
	"name": "@levitate/system-setup",
	"version": "0.1.0",
	"private": true,
	"description": "configure the new system with recsetup: keyboard, time zone, language, hostname, root password and a user, reviewed before anything is applied",
	"license": "(MIT OR Apache-2.0)",
	"bin": {
		"system-setup": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*",
		"@levitate/install-state": "workspace:*",
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recsetup"
		],
		"inspect": {
			"path": [
				"fixtures"
			],
			"stories": [
				{
					"name": "answer everything and apply",
					"about": "The whole step on a target mounted by hand: each question in order (the lists narrowed by typing), the passwords typed twice, the review turned over to recsetup's commands and back, applied after a yes, and the step saved to the install state file.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json",
						"OS_RELEASE": "fixtures/os-release-levitate"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "de",
							"expect": "de-latin1"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "ams",
							"expect": "Europe/Amsterdam"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "\r",
							"expect": "A password for root?"
						},
						{
							"keys": "secret\r",
							"expect": "••••••"
						},
						{
							"keys": "secret\r",
							"expect": "Who uses this machine?"
						},
						{
							"keys": "ann\r",
							"expect": "A password for ann?"
						},
						{
							"keys": "pw\r",
							"expect": "••"
						},
						{
							"keys": "pw\r",
							"expect": "Apply to /mnt"
						},
						{
							"keys": " ",
							"expect": "each inside the new system"
						},
						{
							"keys": " ",
							"expect": "1  Keyboard"
						},
						{
							"keys": "\r",
							"expect": "Apply these six answers to /mnt?"
						},
						{
							"keys": "y",
							"expect": "This machine is yours"
						}
					]
				},
				{
					"name": "from the base step",
					"about": "After base-system: the target comes from the install state file's disk step, so no --target is needed.",
					"env": {
						"INSTALL_STATE": "fixtures/state-base-done.json"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "",
							"expect": "/mnt"
						}
					]
				},
				{
					"name": "a hostname recsetup refuses",
					"about": "A name with an underscore: the character is marked in the field, recsetup's own message and fix show under it, and the question stays open.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "_pc\r",
							"expect": "is not a valid"
						},
						{
							"keys": "",
							"expect": "What to do: use letters"
						}
					]
				},
				{
					"name": "a user name recsetup refuses",
					"about": "A user name with a capital: recsetup refuses it, and the capital is the character marked in the field.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "\r",
							"expect": "A password for root?"
						},
						{
							"keys": "\r",
							"expect": "Who uses this machine?"
						},
						{
							"keys": "Ann\r",
							"expect": "is not a valid user"
						}
					]
				},
				{
					"name": "passwords that differ",
					"about": "The second entry of root's password differs from the first: it says so and asks for both again.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "\r",
							"expect": "A password for root?"
						},
						{
							"keys": "one\r",
							"expect": "•••"
						},
						{
							"keys": "two\r",
							"expect": "The two don't match"
						}
					]
				},
				{
					"name": "nobody could log in",
					"about": "No password for root and no user: the review page refuses to apply and says what to set.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "\r",
							"expect": "A password for root?"
						},
						{
							"keys": "\r",
							"expect": "Who uses this machine?"
						},
						{
							"keys": "\r",
							"expect": "Nobody could log in"
						},
						{
							"keys": "\r",
							"expect": "nobody could log in: set a root password"
						}
					]
				},
				{
					"name": "apply fails",
					"about": "A step fails part-way (the user can't be created): which step, what it printed, recsetup's error, and the steps that did not run.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json",
						"RECSETUP_FIXTURE": "apply-fails"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "de",
							"expect": "de-latin1"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "ams",
							"expect": "Europe/Amsterdam"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "\r",
							"expect": "A password for root?"
						},
						{
							"keys": "secret\r",
							"expect": "••••••"
						},
						{
							"keys": "secret\r",
							"expect": "Who uses this machine?"
						},
						{
							"keys": "ann\r",
							"expect": "A password for ann?"
						},
						{
							"keys": "pw\r",
							"expect": "••"
						},
						{
							"keys": "pw\r",
							"expect": "Apply to /mnt"
						},
						{
							"keys": "\r",
							"expect": "Apply these six answers to /mnt?"
						},
						{
							"keys": "y",
							"expect": "The configuration stopped"
						},
						{
							"keys": "",
							"expect": "cannot lock /etc/passwd"
						}
					]
				},
				{
					"name": "console keeps its layout",
					"about": "loadkeys fails (a serial line): the keyboard page says the new system gets the layout but this console does not.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json",
						"LOADKEYS_FIXTURE": "fails"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "\u001b",
							"expect": "not answered yet"
						},
						{
							"keys": "k",
							"expect": "This console keeps its own layout"
						}
					]
				},
				{
					"name": "try the layout",
					"about": "The keyboard list on a target whose keymaps lie under their families: the selected layout's family and its keys, Tab to the line to try it on, typing there and not into the search, and Tab back. A new search picks a layout of another family.",
					"args": [
						"--target",
						"fixtures/target"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "de",
							"expect": "QWERTZ"
						},
						{
							"keys": "\t",
							"expect": "try it"
						},
						{
							"keys": "zy",
							"expect": "zy"
						},
						{
							"keys": "\t",
							"expect": "de-latin1"
						},
						{
							"keys": "fr",
							"expect": "AZERTY"
						}
					]
				},
				{
					"name": "no system at the target",
					"about": "The target holds no system (the base step has not run): recsetup's error and fix, and nothing is asked.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json",
						"RECSETUP_FIXTURE": "no-system"
					},
					"steps": [
						{
							"expect": "can't be configured"
						},
						{
							"keys": "",
							"expect": "What to do: extract a system"
						}
					]
				},
				{
					"name": "no target",
					"about": "Started before the disk step and without --target: the overview says where the target comes from, and nothing runs.",
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/none.json"
					},
					"steps": [
						{
							"expect": "No system to configure yet"
						}
					]
				},
				{
					"name": "acorn",
					"about": "On AcornOS (the live system's os-release says so) the band names it and the colours are its own.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json",
						"OS_RELEASE": "fixtures/os-release-acorn"
					},
					"steps": [
						{
							"expect": "◆ AcornOS"
						},
						{
							"keys": "",
							"expect": "Start with the keyboard"
						}
					]
				},
				{
					"name": "a desktop user who logs in by itself",
					"about": "On the desktop system, after the user's password: whether the user is logged in at every boot without asking (no is the default); a yes shows on the user's answer and as recsetup's autologin step.",
					"args": [
						"--target",
						"/mnt"
					],
					"env": {
						"INSTALL_STATE": "/tmp/install-system-setup-story/state.json",
						"RECSETUP_FLAVOUR": "desktop"
					},
					"steps": [
						{
							"expect": "Start with the keyboard"
						},
						{
							"keys": "\r",
							"expect": "Search"
						},
						{
							"keys": "\r",
							"expect": "24 of 24"
						},
						{
							"keys": "\r",
							"expect": "en_US.UTF-8"
						},
						{
							"keys": "\r",
							"expect": "levitateos login:"
						},
						{
							"keys": "\r",
							"expect": "A password for root?"
						},
						{
							"keys": "\r",
							"expect": "Who uses this machine?"
						},
						{
							"keys": "ann\r",
							"expect": "A password for ann?"
						},
						{
							"keys": "pw\r",
							"expect": "••"
						},
						{
							"keys": "pw\r",
							"expect": "Log ann in by itself?"
						},
						{
							"keys": "y",
							"expect": "ann, logs in by itself"
						},
						{
							"keys": " ",
							"expect": "autologin ann plasma"
						}
					]
				}
			]
		}
	}
}
