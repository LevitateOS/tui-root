#!/bin/sh
# Stand-in for recsetup in headless runs: it reads no target and changes nothing. It
# prints what `recsetup inspect|plan|apply --root ROOT ... --json` prints for a LevitateOS
# system at ROOT; RECSETUP_FIXTURE selects:
#   no-system    inspect fails: ROOT holds no system built by the builder (E029)
#   apply-fails  apply stops at the user step (E022); the steps after it are not run
#   parts-missing  (RECSETUP_FLAVOUR=desktop) apply stops at the step that fetches the
#                release's package parts (E022), whose output lists the missing parts and the way
#                forward (the network, or --parts-from DIR); a run given --parts-from succeeds
# RECSETUP_FLAVOUR=desktop makes it the release medium, which installs the default software
# set into ROOT (default: base, a medium without one): it plans the software step first,
# asks whether the user logs in by itself and plans the desktop's steps.
# plan and apply refuse a hostname with `_` and a user name with a capital, as recsetup
# does (E030). Keep the JSON in the shape of recsetup's documents (src/domain/recsetup.ts).
cmd=$1
[ $# -gt 0 ] && shift
root=/mnt tz= locale= keymap= hostname= user= rootpw= stdin= autologin= partsfrom=
flavour=${RECSETUP_FLAVOUR:-base}
default_set='[]' desktop=false
[ "$flavour" = desktop ] && default_set='["plasma","konsole","firefox","network","rec-apps"]' desktop=true
while [ $# -gt 0 ]; do
	case "$1" in
	--root) root=$2 && shift 2 ;;
	--timezone) tz=$2 && shift 2 ;;
	--locale) locale=$2 && shift 2 ;;
	--keymap) keymap=$2 && shift 2 ;;
	--hostname) hostname=$2 && shift 2 ;;
	--user) user=$2 && shift 2 ;;
	--autologin) autologin=$2 && shift 2 ;;
	--parts-from) partsfrom=$2 && shift 2 ;;
	--root-password) rootpw=1 && shift ;;
	--passwords-stdin) stdin=1 && shift ;;
	--json) shift ;;
	*)
		echo "fixture recsetup: unsupported: $1" >&2
		exit 2
		;;
	esac
done
fail() { # code number message remediation
	printf '{\n  "schema_version": 1,\n  "code": "%s",\n  "message": "%s",\n  "remediation": "%s"\n}\n' "$1" "$3" "$4" >&2
	exit "$2"
}
target="{\"root\":\"$root\",\"os_id\":\"levitateos\",\"os_name\":\"LevitateOS\",\"profile\":{\"packages\":\"rpm\",\"init\":\"systemd\",\"libc\":\"glibc\",\"privilege\":\"sudo\",\"desktop\":\"plasma\",\"kernel_line\":\"latest\"},\"admin\":{\"group\":\"wheel\",\"tool\":\"sudo\",\"rule_file\":\"/etc/sudoers.d/10-wheel\",\"rule_present\":true},\"has_zoneinfo\":true,\"default_shell\":\"/bin/bash\",\"boot_is_mountpoint\":true,\"default_set\":$default_set,\"desktop\":$desktop}"

if [ "$cmd" = inspect ]; then
	[ "$RECSETUP_FIXTURE" = no-system ] &&
		fail E029 29 "'$root': no etc/os-release or usr/lib/os-release" "extract a system built by the current builder (its /etc/os-release carries the REC_* fields), and point --root at its top directory"
	zones=
	for zone in Africa/Cairo America/New_York America/Sao_Paulo Asia/Kolkata Asia/Tokyo Australia/Sydney Europe/Amsterdam Europe/Athens Europe/Berlin Europe/Brussels Europe/Dublin Europe/Helsinki Europe/Lisbon Europe/London Europe/Madrid Europe/Oslo Europe/Paris Europe/Prague Europe/Rome Europe/Stockholm Europe/Vienna Europe/Warsaw Europe/Zurich UTC; do
		zones="$zones${zones:+,}{\"name\":\"$zone\",\"region\":\"${zone%%/*}\"}"
	done
	zones=$(printf '%s' "$zones" | sed 's/"region":"UTC"/"region":""/')
	locales=
	for locale in cs_CZ de_CH de_DE en_GB en_US es_ES fi_FI fr_FR it_IT nb_NO nl_NL pt_BR pt_PT ru_RU sr_RS sv_SE; do
		locales="$locales${locales:+,}{\"name\":\"$locale.UTF-8\"}"
	done
	keymaps=
	for map in be-latin1 br-abnt2 cz de de-latin1 dvorak es fi fr fr-latin9 it jp106 nl no pl pt-latin1 ru se-latin1 sg uk us us-acentos; do
		keymaps="$keymaps${keymaps:+,}\"$map\""
	done
	printf '%s\n' "{\"schema_version\":1,\"target\":$target,\"choices\":{\"timezones\":[$zones],\"locales\":[$locales],\"keymaps\":[$keymaps],\"shells\":[\"/bin/bash\",\"/bin/sh\"],\"groups\":[\"root\",\"wheel\"],\"users\":[\"root\"],\"services\":[]}}"
	exit 0
fi

case "$cmd" in plan | apply) ;; *)
	echo "fixture recsetup: unsupported command: $cmd" >&2
	exit 2
	;;
esac
case "$hostname" in *_* | -*) fail E030 30 "'$hostname' is not a valid hostname" "use letters, digits and hyphens (not first or last), at most 64 characters, such as my-pc" ;; esac
case "$user" in *[!a-z0-9_-]* | [0-9-]*) fail E030 30 "'$user' is not a valid user name" "start with a lowercase letter or _, then lowercase letters, digits, _ or -, at most 32 characters" ;; esac

status=planned
[ "$cmd" = apply ] && status=done
steps= index=0 failed= failmsg=
step() { # section description command
	state=$status
	stderr="useradd: cannot lock /etc/passwd; try again later.\\n"
	if [ "$cmd" = apply ] && [ -n "$failed" ]; then
		state=not_run
	elif [ "$cmd" = apply ] && [ "$RECSETUP_FIXTURE" = apply-fails ] && [ "$1" = users ]; then
		state=failed failed=1 failmsg="'Create user $user' failed with exit status 9"
	elif [ "$cmd" = apply ] && [ "$RECSETUP_FIXTURE" = parts-missing ] && [ -z "$partsfrom" ] && [ "$1" = fetch ]; then
		state=failed failed=1 failmsg="'Fetch the default software set's package parts' failed with exit status 9"
		stderr="cannot reach https://github.com/LevitateOS/releases/releases/download/levitateos-7/release.json\\nThe list of parts could not be read either: cannot reach https://github.com/LevitateOS/releases/releases/download/levitateos-7/release.json. Way forward: connect this live session to the network (NetworkManager is running; use the network icon in the panel or nmtui), or give the folder that holds the release's parts (release.json, release.json.sig and the parts-*.tar.zst files) with --parts-from DIR, then run the same command again. Parts already fetched are kept.\\n"
	fi
	[ "$1" = fetch ] && set -- software "$2" "$3"
	extra=
	[ "$cmd" = apply ] && extra=",\"status\":\"$state\""
	[ "$state" = done ] && extra="$extra,\"exit_status\":0,\"stdout\":\"\",\"stderr\":\"\""
	[ "$state" = failed ] && extra="$extra,\"exit_status\":9,\"stdout\":\"\",\"stderr\":\"$stderr\""
	steps="$steps${steps:+,}{\"index\":$index,\"section\":\"$1\",\"description\":\"$2\",\"command\":\"$3\"$extra}"
	index=$((index + 1))
}
setup=/usr/libexec/recipe-system-setup
parts=$root/var/tmp/recipe-parts
fromflag=
[ -n "$partsfrom" ] && fromflag=" --from $partsfrom"
[ "$flavour" = desktop ] && step fetch "Fetch the default software set's package parts (from the network, or the folder given with --parts-from) into the target disk" "RECUPDATE_CACHE_DIR=$parts/download RECUPDATE_RECIPE_CACHE_DIR=$parts/cache recupdate fetch-parts$fromflag"
[ "$flavour" = desktop ] && step software "Install the default software set through Recipe (5 recipes), from the fetched package parts" "RECIPE_CACHE_DIR=$parts/cache recipe --system --root $root --recipes-path /usr/lib/recsetup/default-set/recipes install plasma konsole firefox network rec-apps"
[ "$flavour" = desktop ] && step software "Remove the fetched package parts from the target disk" "rm -rf --one-file-system $parts"
[ -n "$tz" ] && step timezone "Set the time zone to $tz" "recchroot $root -- $setup timezone $tz"
[ -n "$locale" ] && step locale "Set the system locale to $locale" "recchroot $root -- $setup locale $locale"
[ -n "$keymap" ] && step keymap "Set the console keymap to $keymap" "recchroot $root -- $setup keymap $keymap"
[ -n "$keymap" ] && [ "$flavour" = desktop ] && step keymap "Set the desktop's keyboard layout to the one matching $keymap" "recsetup x11-keyboard --root $root $keymap"
[ -n "$hostname" ] && step hostname "Set the hostname and hosts mapping to $hostname" "recchroot $root -- $setup hostname $hostname"
session=
[ "$flavour" = desktop ] && session=" video,input,audio,netdev,plugdev,lpadmin,scanner,camera"
[ -n "$user" ] && step users "Create user $user" "recchroot $root -- $setup user $user /bin/bash wheel$session"
who=
[ -n "$rootpw" ] && who=root
[ -n "$user" ] && who="$who${who:+, }$user"
[ -n "$who" ] && step passwords "Set the password of $who (read from stdin)" "recchroot $root -- chpasswd"
[ -n "$autologin" ] && step autologin "Log $autologin in to the desktop at every boot without asking" "recchroot $root -- $setup autologin $autologin plasma"
names=$(printf '%s' "$who" | sed 's/, /","/g')
[ -n "$names" ] && names="\"$names\""

if [ "$cmd" = plan ]; then
	printf '%s\n' "{\"schema_version\":1,\"target\":$target,\"request\":{},\"steps\":[$steps],\"warnings\":[],\"password_users\":[$names]}"
	exit 0
fi
[ -n "$stdin" ] && cat >/dev/null
if [ -n "$failed" ]; then
	printf '%s\n' "{\"schema_version\":1,\"dry_run\":false,\"target\":$target,\"steps\":[$steps],\"warnings\":[],\"error\":{\"schema_version\":1,\"code\":\"E022\",\"message\":\"$failmsg\"}}"
	fail E022 22 "$failmsg" "fix what the step's output says, then apply again"
fi
printf '%s\n' "{\"schema_version\":1,\"dry_run\":false,\"target\":$target,\"steps\":[$steps],\"warnings\":[],\"error\":null}"
