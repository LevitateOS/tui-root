{
	"name": "@levitate/install-hub",
	"version": "0.1.0",
	"private": true,
	"description": "the install's steps in order: starts each step's app, runs the guide's commands, or opens a shell, and keeps where the install stands",
	"license": "(MIT OR Apache-2.0)",
	"bin": {
		"install-hub": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*",
		"@levitate/install-state": "workspace:*",
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"tools": [
			"recfstab",
			"recchroot",
			"recsetup"
		],
		"inspect": {
			"stories": [
				{
					"name": "fresh install",
					"about": "Nothing done yet: the preflight checks come first.",
					"env": {
						"INSTALL_STATE": "fixtures/fresh.json"
					},
					"steps": [
						{
							"expect": "Can this machine take the install?"
						},
						{
							"keys": "",
							"expect": "Booted in UEFI mode"
						}
					],
					"args": [
						"--os-name",
						"LevitateOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/live"
					]
				},
				{
					"name": "steps wait their turn",
					"about": "Starting a step before the ones it needs says which comes first.",
					"env": {
						"INSTALL_STATE": "fixtures/fresh.json"
					},
					"steps": [
						{
							"keys": "jj",
							"expect": "Waits for the preflight and the disk."
						},
						{
							"keys": "\\r",
							"expect": "first: Preflight"
						}
					],
					"args": [
						"--os-name",
						"LevitateOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/live"
					]
				},
				{
					"name": "not a UEFI boot",
					"about": "The preflight check fails on a machine booted in legacy BIOS mode, and says what to do.",
					"args": [
						"--os-name",
						"LevitateOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/bios"
					],
					"env": {
						"INSTALL_STATE": "fixtures/fresh.json"
					},
					"steps": [
						{
							"expect": "This boot cannot take the install"
						}
					]
				},
				{
					"name": "disk done",
					"about": "After disk-plan: the base step opens base-system on the disk's target.",
					"env": {
						"INSTALL_STATE": "fixtures/disk-done.json"
					},
					"steps": [
						{
							"expect": "Start base-system"
						},
						{
							"keys": "",
							"expect": "Copy the system onto the disk and write its fstab."
						},
						{
							"keys": "k",
							"expect": "/dev/vda, A/B"
						},
						{
							"keys": "jjj",
							"expect": "LevitateOS (slot B)"
						}
					],
					"args": [
						"--os-name",
						"LevitateOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/live"
					]
				},
				{
					"name": "mutable boot",
					"about": "A mutable disk, configured: the boot step names the root device.",
					"env": {
						"INSTALL_STATE": "fixtures/mutable-configured.json"
					},
					"steps": [
						{
							"expect": "recsetup apply --root /mnt --boot mutable --root-device /dev/vda2 --machine-id"
						}
					],
					"args": [
						"--os-name",
						"LevitateOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/live"
					]
				},
				{
					"name": "ready to reboot",
					"about": "Every step done: the finish page shows the machine as a card.",
					"env": {
						"INSTALL_STATE": "fixtures/all-done.json"
					},
					"steps": [
						{
							"expect": "Ready to reboot"
						},
						{
							"keys": "k",
							"expect": "The boot loader is installed"
						},
						{
							"keys": "j",
							"expect": "studio"
						}
					],
					"args": [
						"--os-name",
						"LevitateOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/live"
					]
				},
				{
					"name": "acorn",
					"about": "On AcornOS the launcher names it; the configuration step opens system-setup, and says how to mark it done when it was typed by hand.",
					"args": [
						"--os-name",
						"AcornOS",
						"--shell",
						"/bin/sh",
						"--live-root",
						"fixtures/live"
					],
					"env": {
						"INSTALL_STATE": "fixtures/base-done.json"
					},
					"steps": [
						{
							"expect": "◆ AcornOS"
						},
						{
							"keys": "",
							"expect": "Start system-setup"
						},
						{
							"keys": "",
							"expect": "d marks the"
						}
					]
				}
			],
			"path": [
				"fixtures/bin"
			]
		},
		"distroArgs": {
			"osName": "--os-name",
			"shell": "--shell"
		}
	}
}
