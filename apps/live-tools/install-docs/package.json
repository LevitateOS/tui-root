{
	"name": "@levitate/install-docs",
	"version": "0.2.0",
	"description": "the docs, for reading beside a shell",
	"license": "(MIT OR Apache-2.0)",
	"bin": {
		"install-docs": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*",
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"inspect": {
			"pages": {
				"list": [
					"--pages"
				],
				"arg": "--slug"
			},
			"mask": [
				"page \\d+/\\d+"
			],
			"stories": [
				{
					"name": "content focused",
					"about": "Tab moves focus from the page list into the page.",
					"args": [
						"--os-name",
						"LevitateOS"
					],
					"steps": [
						{
							"keys": "\\t"
						}
					]
				},
				{
					"name": "next page",
					"about": "Moving through the guide page by page.",
					"args": [
						"--os-name",
						"LevitateOS"
					],
					"steps": [
						{
							"keys": "l",
							"expect": "Step-by-step guide to installing"
						},
						{
							"keys": "h",
							"expect": "Get the LevitateOS live ISO"
						}
					]
				},
				{
					"name": "acorn pages",
					"about": "On AcornOS the launcher passes --os-name AcornOS, and the guide is AcornOS's.",
					"args": [
						"--os-name",
						"AcornOS"
					],
					"steps": [
						{
							"keys": "l",
							"expect": "Step-by-step guide to installing AcornOS"
						}
					]
				},
				{
					"name": "acorn same slugs",
					"about": "AcornOS's pages have the same slugs as LevitateOS's, so other apps' links work on both.",
					"args": [
						"--os-name",
						"AcornOS",
						"--slug",
						"installation-disk"
					],
					"steps": [
						{
							"keys": "j",
							"expect": "Disk Preparation  lines 2-"
						}
					]
				},
				{
					"name": "tabs in code",
					"about": "A page whose code blocks hold tabs (recfstab), drawn without breaking the layout.",
					"args": [
						"--os-name",
						"LevitateOS",
						"--slug",
						"recfstab"
					],
					"steps": [
						{
							"keys": "jjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjj",
							"expect": "│ 5 │UUID=ABCD-1234  /boot   vfat    relatime,fmask=0022,dmask=0022"
						}
					]
				},
				{
					"name": "selected command",
					"about": "Selecting a command on the disk page, ready to copy into the shell beside it.",
					"args": [
						"--os-name",
						"LevitateOS",
						"--slug",
						"installation-disk"
					],
					"steps": [
						{
							"keys": "\\tjj",
							"expect": "▸ ls /sys/firmware/efi/efivars (c to copy)"
						},
						{
							"keys": "j",
							"expect": "▸ loadkeys us (c to copy)"
						}
					]
				}
			]
		},
		"distroArgs": {
			"osName": "--os-name"
		}
	}
}
