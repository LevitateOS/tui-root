{
	"name": "@levitate/install-docs",
	"version": "0.2.0",
	"description": "the docs, for reading beside a shell",
	"license": "(MIT OR Apache-2.0)",
	"bin": {
		"install-docs": "./src/main.tsx"
	},
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --config ../../../../.oxlintrc.json src --deny-warnings",
		"format": "oxfmt --config ../../../../.oxfmtrc.json --write src package.json tsconfig.json",
		"format:check": "oxfmt --config ../../../../.oxfmtrc.json --check src package.json tsconfig.json"
	},
	"dependencies": {
		"@levitate/docs-content": "workspace:*",
		"@levitate/tui-kit": "workspace:*",
		"ink": "^6.8.0",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.17",
		"@types/react": "^19.2.0",
		"typescript": "^5.9.2"
	},
	"levitate": {
		"inspect": {
			"pages": {
				"list": [
					"--pages"
				],
				"arg": "--slug"
			},
			"mask": [
				"page \\d+/\\d+"
			],
			"stories": [
				{
					"name": "content focused",
					"steps": [
						{
							"keys": "\\t"
						}
					]
				},
				{
					"name": "next page",
					"steps": [
						{
							"keys": "l",
							"expect": "││ Step-by-step guide to installing"
						},
						{
							"keys": "h",
							"expect": "││ Download a LevitateOS variant"
						}
					]
				},
				{
					"name": "tabs in code",
					"args": [
						"--slug",
						"recfstab"
					],
					"steps": [
						{
							"keys": "jjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjj",
							"expect": "│ 5 │UUID=ABCD-1234  /boot   vfat    fmask=0022,dmask=0022"
						}
					]
				},
				{
					"name": "selected command",
					"args": [
						"--slug",
						"installation-disk"
					],
					"steps": [
						{
							"keys": "\\tjj",
							"expect": "▸ ls /sys/firmware/efi/efivars (c to copy)"
						},
						{
							"keys": "j",
							"expect": "▸ loadkeys us (c to copy)"
						}
					]
				}
			]
		}
	}
}
